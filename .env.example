# =============================================================================
# CONFIGURACIÓN DE CONEXIÓN A BASE DE DATOS - CLÍNICA MÉDICA
# =============================================================================
# Copia este archivo a `.env` y completa con las credenciales que proporcione tu equipo.

# --- OPCIÓN 1: Supabase (Recomendado) ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# Cadena de conexión directa a PostgreSQL (Transaction Pooler o Direct Connection)
# Formato: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres.tu_ref:tu_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- OPCIÓN 2: PostgreSQL Local / Docker ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clinica_medica
DB_USER=postgres
DB_PASSWORD=tu_password_local
